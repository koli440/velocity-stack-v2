# Google Analytics 4 Measurement ID (optional; analytics is disabled when unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# MapTiler API key for map tiles (restrict by domain in MapTiler; falls back to OpenStreetMap tiles when unset)
NEXT_PUBLIC_MAP_TILES_KEY=

# Server-side activity sync (planned: Strava, background sync). Set as hosting env settings, never commit values.
# Intervals.icu uses each rider's own API key stored in profile_secrets; no server secret is needed.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
# Supabase service-role key for background sync jobs (server only, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=
