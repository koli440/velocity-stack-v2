# Google Analytics 4 Measurement ID (optional; analytics is disabled when unset)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Reddit Pixel ID (a2_xxxxxxxx); optional, no script is loaded when empty
NEXT_PUBLIC_REDDIT_PIXEL_ID=

# MapTiler API key for map tiles (restrict by domain in MapTiler; falls back to OpenStreetMap tiles when unset)
NEXT_PUBLIC_MAP_TILES_KEY=

# Server-side activity sync. Set as hosting env settings, never commit values.
# Intervals.icu uses each rider's own API key; no server secret is needed.
# Strava: create an API app at https://www.strava.com/settings/api, set its "Authorization Callback Domain" to the
# app's host (e.g. www.velocity-stack.app) and copy the client id/secret here. Without them the Strava card shows
# a "not set up" state. The client secret also signs the OAuth state; the webhook verify token lives in the database.
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# Wahoo Cloud (https://developers.wahooligan.com): redirect URI https://www.velocity-stack.app/api/connections/wahoo/callback,
# webhook https://www.velocity-stack.app/api/webhooks/wahoo. WAHOO_WEBHOOK_TOKEN is the token configured on the Wahoo app.
WAHOO_CLIENT_ID=
WAHOO_CLIENT_SECRET=
WAHOO_WEBHOOK_TOKEN=
# Supabase service-role key for background sync jobs (server only, never NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Automatic Intervals.icu sync: the pg_cron job in supabase/migrations/20261027000000_intervals_auto_sync.sql calls
# POST /api/sync/intervals/run on the production URL (public.sync_settings 'app_base_url') with a token the migration
# generates in the database. The endpoint needs SUPABASE_SERVICE_ROLE_KEY (above) to verify the token and import rides.

# Strava (migration 20261028000000_strava.sql): pg_cron job 'strava-sync' polls POST /api/sync/strava/run every 15 min as a
# fallback; webhook events arrive at /api/webhooks/strava (subscription is created automatically when the first rider
# connects Strava, or manually with POST /api/webhooks/strava/subscribe while signed in).

# Notification emails (migration 20261222000000_notification_emails.sql): pg_cron calls POST /api/notifications/email/run.
# Without RESEND_API_KEY the endpoint does nothing. MAIL_FROM must be a sender verified at the provider.
RESEND_API_KEY=
MAIL_FROM=
# Sign-up confirmation emails are sent by Supabase Auth ("Confirm email" is enabled in supabase/config.toml).
